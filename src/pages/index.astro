
---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// Load your existing biography
const bioEntry = await getEntry("bio", "bio");
const { Content: BioContent } = bioEntry
  ? await render(bioEntry)
  : { Content: null };

// Selected academic work


const selectedWork = [
  {
    type: "PUBLISHED RESEARCH",
    title: "From Pocket to Physics: Unlocking the Potential of Smartphone Sensor Experiments to Enhance Science Learning",
    meta: "Journal of Research on Technology in Education · 2026",
    href: "https://doi.org/10.1080/15391523.2025.2598247",
    external: true,
  },
  {
    type: "PUBLISHED RESEARCH",
    title: "Effectiveness of Worksheets in Science Students’ Learning Outcomes: A Meta-Analysis",
    meta: "International Journal of Education in Mathematics, Science and Technology · 2026",
    href: "https://doi.org/10.46328/ijemst.5408",
    external: true,
  },
  {
    type: "UNDERGRADUATE THESIS",
    title: "Development of Intervention Material in Chemistry: A First-Aid Kit",
    meta: "University of Southeastern Philippines",
    href: "/projects/",
    external: false,
  },
];

---

<BaseLayout
  title="Home"
  description="The academic portfolio of Mark Justine N. Revano, science educator and researcher."
>
  <main class="home-editorial">

    
    <!-- INTRODUCTION -->
    <section class="home-hero">
      <div class="home-hero-grid">

        <div class="home-hero-copy">
          <h1>
            Towards a different kind of scholarship in education—
          </h1>

          <p class="home-hero-manifesto">
            one that starts with conversation, embraces joyful
            struggle, and puts science for the people.
          </p>

          <p class="home-hero-deck">
            A romantic, humble sprout of a scholar finding my
            footing as a science teacher-to-be.
          </p>
        </div>

        <figure class="home-hero-portrait">
          <img
            src="/mark-revano.jpg"
            alt="Portrait of Mark Justine N. Revano"
            loading="eager"
          />
        </figure>

      </div>
    </section>

    <!-- ACADEMIC HIGHLIGHTS -->
    <div class="home-profile-grid">

      <!-- ACADEMIC BACKGROUND -->
      <article class="home-profile-item">
        <img
          src="/images/graduation-portrait-cap.jpg"
          alt="Mark Justine N. Revano at his USeP graduation"
          class="home-profile-image academic-photo"
        />

        <p class="home-eyebrow">ACADEMIC BACKGROUND</p>
        <h3>A forever learner.</h3>
        <p>
          Graduated Bachelor of Secondary Education Major in Science.
          · University of Southeastern Philippines. Cum Laude.
        </p>
      </article>

      <!-- RESEARCH INTERESTS -->
      <article class="home-profile-item">
        <img
          src="/images/chemistry-kit-presentation.jpg"
          alt="Presenting a chemistry learning material"
          class="home-profile-image"
        />

        <p class="home-eyebrow">RESEARCH INTERESTS</p>
        <h3>Curiosity to practice.</h3>
        <p>
          Science education, Natural sciences, Bibliometrics,
          and Intellectual life.
        </p>
      </article>

      <!-- RECOGNITION -->
      <article class="home-profile-item">
        <img
          src="/images/tec-award-ceremony.jpg"
          alt="TEC Teachers Awards 2026 recognition ceremony"
          class="home-profile-image"
        />

        <p class="home-eyebrow">RECOGNITION</p>
        <h3>Science for the People.</h3>
        <p>
          Pre-Service Teacher Research Champion,
          Teacher Education Council (TEC) 2026 Teachers Awards.
        </p>
      </article>

    </div>


    </section>

   <!-- BIOGRAPHY -->
    <section class="home-about">
      <div class="home-section-header">
        <div>
          <p class="home-eyebrow">BACKGROUND & INTERESTS</p>
      </div>

      <div class="prose home-bio">
        {BioContent ? <BioContent /> : <p>Biography unavailable.</p>}
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section class="home-selected">
      <header class="home-section-header">
        <div>
          <p class="home-eyebrow">A SELECTION OF MY WORK</p>
          <h2>Research & Projects</h2>
        </div>
      
<div class="home-work-grid">
  {selectedWork.map((item, index) => (
    <article class="home-work-card">
      <span class="home-work-number">
        0{index + 1}
      </span>

      <p class="home-work-type">{item.type}</p>

      <h3>
        <a
          class="home-work-title"
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
        >
          {item.title}
          <span class="home-work-icon" aria-hidden="true">&nbsp;↗</span>
        </a>
      </h3>
	  <p class="home-work-meta">
  {item.meta}
</p>
    </article>
  ))}
</div>
    </section>

    
<!-- CONTACT -->
<section class="home-contact-panel" id="contact">

  <!-- LEFT: PERSONAL INFORMATION -->
  <div class="contact-profile">

    <img
      src="/mark-revano.jpg"
      alt="Portrait of Mark Justine N. Revano"
      class="contact-portrait"
    />

    <h2>Mark Justine N. Revano</h2>

    <p class="contact-role">
      Science Educator · Independent Scholar
    </p>

    <div class="contact-details">

      <a href="mailto:markjustinerevano@gmail.com">
        <span aria-hidden="true">✉</span>
        markjustinerevano@gmail.com
      </a>

      <a href="YOUR_LINKEDIN_URL" target="_blank"
         rel="noopener noreferrer">
        <span aria-hidden="true">in</span>
        LinkedIn
      </a>

    </div>

  </div>

  <!-- RIGHT: MESSAGE FORM -->
  <div class="contact-form-panel">

    <p class="home-eyebrow">LET'S CONNECT</p>

    <h2>Send me a message!</h2>

    <form
  class="contact-form"
  action="https://formspree.io/f/xyeenkdo"
  method="POST"
>

      <div class="contact-field">
        <label for="contact-name">Full Name</label>
        <input
          type="text"
          id="contact-name"
          name="name"
          placeholder="Enter your full name"
          required
        />
      </div>

      <div class="contact-field">
        <label for="contact-email">Email Address</label>
        <input
          type="email"
          id="contact-email"
          name="email"
          placeholder="Enter your email"
          required
        />
      </div>

      <div class="contact-field">
        <label for="contact-message">Message</label>
        <textarea
          id="contact-message"
          name="message"
          placeholder="Write your message..."
          rows="5"
          required
        ></textarea>
      </div>

      <button type="submit" class="contact-submit">
        Send ↗
      </button>
    </form>
  </div>
</section>


  </main>
</BaseLayout>
