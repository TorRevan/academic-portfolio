
---
import BaseLayout from "../layouts/BaseLayout.astro";

// Selected academic work
const selectedWork = [
  {
    type: "JOURNAL ARTICLE",
    title: "From Pocket to Physics: Unlocking the Potential of Smartphone Sensor Experiments to Enhance Science Learning",
    meta: "Journal of Research on Technology in Education · 2026",
    href: "https://doi.org/10.1080/15391523.2025.2598247",
    external: true,
    image: "/images/jrte-cover.jpg",
    imageAlt: "Cover of the Journal of Research on Technology in Education",
  },
  {
    type: "JOURNAL ARTICLE",
    title: "Effectiveness of Worksheets in Science Students’ Learning Outcomes: A Meta-Analysis",
    meta: "International Journal of Education in Mathematics, Science and Technology · 2026",
    href: "https://doi.org/10.46328/ijemst.5408",
    external: true,
    image: "/images/ijemst-cover.jpg",
    imageAlt: "Cover of the International Journal of Education in Mathematics, Science and Technology",
  },
  {
    type: "CORRESPONDENCE",
    title: "Contextualizing academic mentorship in Asia: A Philippine perspective on Kapwa and Pakikisama",
    meta: "Medical Teacher · 2026",
    href: "https://doi.org/10.1080/0142159X.2026.2715001",
    external: true,
    image: "/images/medical-teacher-cover.jpg",
    imageAlt: "Cover of Medical Teacher",
  },
  {
    type: "CORRESPONDENCE",
    title: "Localizing soil science education for Philippine classrooms and communities",
    meta: "Natural Sciences Education · 2026",
    href: "https://doi.org/10.1002/nse2.70094",
    external: true,
    image: "/images/natural-sciences-education-cover.jpg",
    imageAlt: "Cover of Natural Sciences Education",
  },
  {
    type: "UNDERGRADUATE THESIS",
    title: "Development of Intervention Material in Chemistry: A First-Aid Kit",
    meta: "University of Southeastern Philippines",
    href: "/projects/",
    external: false,
    image: "/images/usep-thesis-image.png",
    imageAlt: "University of Southeastern Philippines seal",
  },
];
---

<BaseLayout
  title="Home"
  description="The academic portfolio of Mark Justine N. Revano, science educator and researcher."
>
  <main class="home-editorial">

    <!-- INTRODUCTION -->
    <section class="home-intro">
      <div class="home-intro-grid">

        <div class="home-intro-copy">
          <p class="home-intro-greeting">Hello, there!</p>

          <h1>I'm Mark Justine<br />N. Revano</h1>

          <p class="home-intro-description">
            A romantic, humble sprout of a scholar finding my footing as a science teacher-to-be.
          </p>

          <div class="home-intro-actions">
            <a
              href="/files/Mark-Justine-Revano-CV.pdf"
              download="Mark-Justine-Revano-CV.pdf"
              class="home-intro-button"
            >
              View My CV
            </a>
            <a href="#contact" class="home-intro-contact">Contact Me</a>
          </div>
        </div>

        <figure class="home-intro-portrait">
          <img
            src="/mark-revano.jpg"
            alt="Portrait of Mark Justine N. Revano"
            loading="eager"
          />
        </figure>

      </div>
    </section>

    <!-- ACADEMIC HIGHLIGHTS -->
    <div class="home-profile-grid">

      <!-- ACADEMIC BACKGROUND -->
      <article class="home-profile-item">
        <img
          src="/images/graduation-portrait-cap.jpg"
          alt="Mark Justine N. Revano at his USeP graduation"
          class="home-profile-image academic-photo"
        />

        <p class="home-eyebrow">ACADEMIC BACKGROUND</p>
        <h3>A forever learner.</h3>
        <p>
          Graduated Bachelor of Secondary Education Major in Science.
          · University of Southeastern Philippines. Cum Laude.
        </p>
      </article>

      <!-- RESEARCH INTERESTS -->
      <article class="home-profile-item">
        <img
          src="/images/chemistry-kit-presentation.jpg"
          alt="Presenting a chemistry learning material"
          class="home-profile-image"
        />

        <p class="home-eyebrow">RESEARCH INTERESTS</p>
        <h3>Curiosity to practice.</h3>
        <p>
          Science education, Natural sciences, Bibliometrics,
          and Intellectual life.
        </p>
      </article>

      <!-- RECOGNITION -->
      <article class="home-profile-item">
        <img
          src="/images/tec-award-ceremony.jpg"
          alt="TEC Teachers Awards 2026 recognition ceremony"
          class="home-profile-image"
        />

        <p class="home-eyebrow">RECOGNITION</p>
        <h3>Science for the People.</h3>
        <p>
          Pre-Service Teacher Research Champion,
          Teacher Education Council (TEC) 2026 Teachers Awards.
        </p>
      </article>

    </div>

    <!-- ABOUT ME -->
    <section class="home-about" id="about">

      <div class="home-about-grid">

        <div class="home-about-main">
          <p class="home-eyebrow">ABOUT ME</p>

          <p class="home-about-text">
            I hold a Bachelor of Secondary Education major in Science from
            the University of Southeastern Philippines (USeP), where I
            graduated cum laude and was a DOST-SEI scholar. As an
            undergraduate, I published several research articles in
            internationally recognized journals indexed in Scopus and
            Web of Science. My research interests include addressing
            misconceptions in chemistry, using smartphone sensors as mobile
            laboratories, bibliometrics, and intellectual life. Beyond
            conducting research, I contribute to the broader academic
            community as an editorial board member and peer reviewer for
            international journals. I also occasionally serve as a resource
            speaker and research panelist at local academic institutions
            and tutor aspiring DOST scholars in General Science. In
            recognition of my sustained commitment to scholarship, I was
            named one of three national Pre-Service Teacher Research
            Champions at the 2026 Teacher Education Council (TEC) Teachers
            Awards. Currently, I collaborate with former professors and
            academics from various institutions to advance research
            initiatives in science education.
          </p>
        </div>

        <figure class="home-about-image">
          <img
            src="/images/about-science-activity.png"
            alt="Students participating in a hands-on science learning activity"
            loading="lazy"
          />
        </figure>

      </div>

    </section>

    <!-- RECENT WORK & PUBLICATIONS -->
    <section class="home-publications" id="work">

      <header class="home-publications-header">
        <h2>Recent Work & Publications</h2>
      </header>

      <div class="home-publications-grid">
        {selectedWork.map((item, index) => (
          <article
            class={`home-publication-card has-cover ${index === 4 ? "home-publication-featured" : ""}`}
          >
            <figure class={`home-publication-cover ${index === 4 ? "home-project-image" : ""}`}>
              <img
                src={item.image}
                alt={item.imageAlt}
                loading="lazy"
              />
            </figure>

            <div class="home-publication-content">

              <div class="home-publication-top">
                <span class="home-publication-number">
                  0{index + 1}
                </span>

                <span class="home-publication-type">
                  {item.type}
                </span>
              </div>

              <div class="home-publication-body">
                <h3>
                  <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                  >
                    {item.title}
                  </a>
                </h3>

                <p class="home-publication-meta">
                  {item.meta}
                </p>
              </div>

              <a
                class="home-publication-link"
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.external ? "Read Publication" : "Explore Project"}
                <span aria-hidden="true">↗</span>
              </a>

            </div>
          </article>
        ))}
      </div>

    </section>

    <!-- CONTACT -->
    <section class="home-contact-panel" id="contact">

      <!-- LEFT: PERSONAL INFORMATION -->
      <div class="contact-profile">

        <img
          src="/mark-revano.jpg"
          alt="Portrait of Mark Justine N. Revano"
          class="contact-portrait"
        />

        <h2>Mark Justine N. Revano</h2>

        <p class="contact-role">
          Science Educator · Independent Scholar
        </p>

        <!-- SOCIAL LINKS -->
        <div class="contact-social-links">

          <!-- Email -->
          <a
            href="mailto:markjustinerevano@gmail.com"
            aria-label="Email"
            title="Email"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/mark-justine-revano/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="4" />
              <path d="M8 10v7m0-10v.01M12 17v-7m0 3a3 3 0 0 1 6 0v4" />
            </svg>
          </a>

          <!-- ResearchGate -->
          <a
            href="https://www.researchgate.net/profile/Mark-Justine-Revano"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ResearchGate"
            title="ResearchGate"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
              <rect x="2.5" y="3.5" width="19" height="17" rx="4" />
              <text x="12" y="15.2" text-anchor="middle" fill="currentColor" stroke="none" font-size="8" font-weight="600">RG</text>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href="https://www.facebook.com/markjustinerevano"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            title="Facebook"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M13.5 20v-7h2.3l.4-2.7h-2.7V8.5c0-.8.4-1.3 1.4-1.3h1.4V4.8c-.3 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.7v1.9H8.3V13h2.4v7" />
            </svg>
          </a>

          <!-- Google Scholar -->
          <a
            href="https://scholar.google.com/citations?user=hAhw7I0AAAAJ&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google Scholar"
            title="Google Scholar"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="m2 9 10-5 10 5-10 5L2 9Z" />
              <path d="M6 11v5c3.7 2.6 8.3 2.6 12 0v-5" />
              <path d="M22 9v6" />
            </svg>
          </a>

          <!-- ORCID -->
          <a
            href="https://orcid.org/0009-0003-4573-4569"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ORCID"
            title="ORCID"
          >
            <img src="/images/orcid-id.svg" alt="" />
          </a>

        </div>
      </div>

      <!-- RIGHT: MESSAGE FORM -->
      <div class="contact-form-panel">

        <p class="home-eyebrow">LET'S CONNECT</p>

        <h2>Send me a message!</h2>

        <form
          class="contact-form"
          action="https://formspree.io/f/xyeenkdo"
          method="POST"
        >

          <div class="contact-field">
            <label for="contact-name">Full Name</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              placeholder="Enter your full name"
              required
            />
          </div>

          <div class="contact-field">
            <label for="contact-email">Email Address</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              placeholder="Enter your email"
              required
            />
          </div>

          <div class="contact-field">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              placeholder="Write your message..."
              rows="5"
              required
            ></textarea>
          </div>

          <button type="submit" class="contact-submit">
            Send ↗
          </button>

        </form>
      </div>

    </section>

  </main>
</BaseLayout>
