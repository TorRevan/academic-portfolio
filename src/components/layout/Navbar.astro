
---
import { NAV_LINKS, PAGES } from "../../config";

const currentPath = Astro.url.pathname;

const visibleLinks = NAV_LINKS.filter((link) => {
  const isHome = link.href === "/";
  const pageKey = isHome
    ? "home"
    : link.href.split("/").filter(Boolean)[0];

  const pageConfig = (PAGES as any)[pageKey];

  return link.isActive !== false && pageConfig?.active !== false;
});
---

<header class="site-header">
  <a href="/" class="site-wordmark">
    <span class="site-wordmark-name">
      Mark Justine N. Revano
    </span>
    <span class="site-wordmark-subtitle">
      Science Education · Scholarship · Innovation
    </span>
  </a>

  <nav class="navbar" aria-label="Main navigation">
    <ul class="nav-links">
      {visibleLinks.map((link) => {
        const isCV = link.href === "/cv";
        const destination = isCV
          ? "/files/Mark-Justine-Revano-CV.pdf"
          : link.href;

        const isCurrentPage =
          !isCV &&
          (currentPath === link.href ||
            (link.href !== "/" && currentPath.startsWith(link.href)));

        return (
          <li>
            <a
              href={destination}
              download={isCV ? "Mark-Justine-Revano-CV.pdf" : undefined}
              class={`nav-link ${isCurrentPage ? "active" : "inactive"}`}
            >
              {link.label}
              <span class="nav-link-line" />
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
